<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>

<package format="3">
    <name>rviz_plugin_view_animated_msgs</name>
    <version>1.0.0</version>
    <description>ROS2 Messages to support the rviz_plugin_view_animated package.</description>

    <license>BSD</license>
    <author>Werner Alexander Isop</author>
    <author email="isop.alexander@gmail.com">Werner Alexander Isop</author>
    <maintainer email="isop.alexander@gmail.com">Werner Alexander Isop</maintainer>
    <url type="website">https://github.com/weraleiso/rviz_plugin_view_animated_msgs</url>
    <url type="repository">https://github.com/weraleiso/rviz_plugin_view_animated_msgs</url>
    <url type="bugtracker">https://github.com/weraleiso/rviz_plugin_view_animated_msgs</url>

    <!--Related utilized or refactored original work(s)/ROS-Package(s):-->
    <author email="adamleeper@gmail.com">Adam Leeper</author>
    <maintainer email="evanflynn.msu@gmail.com">Evan Flynn</maintainer>
    <url type="repository">https://github.com/ros-visualization/view_controller_msgs</url>

    <buildtool_depend>ament_cmake</buildtool_depend>
    <depend>rclcpp</depend>
    <depend>std_msgs</depend>
    <depend>geometry_msgs</depend>

    <test_depend>ament_lint_auto</test_depend>
    <test_depend>ament_lint_common</test_depend>

    <buildtool_depend>rosidl_default_generators</buildtool_depend>
    <exec_depend>rosidl_default_runtime</exec_depend>
    <member_of_group>rosidl_interface_packages</member_of_group>

    <export>
