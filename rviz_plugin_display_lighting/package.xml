<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>

<package format="3">
    <name>rviz_plugin_display_lighting</name>
    <version>1.0.0</version>
    <description>An RViz Display plugin to enable lighting and shadows.</description>

    <license>BSD</license>
    <author>Werner Alexander Isop</author>
    <author email="isop.alexander@gmail.com">Werner Alexander Isop</author>
    <maintainer email="isop.alexander@gmail.com">Werner Alexander Isop</maintainer>
    <url type="website">https://github.com/weraleiso/rviz_plugin_display_lighting</url>
    <url type="repository">https://github.com/weraleiso/rviz_plugin_display_lighting</url>
    <url type="bugtracker">https://github.com/weraleiso/rviz_plugin_display_lighting</url>

    <!--Related utilized or refactored original work(s)/ROS-Package(s):-->
    <author email="terence.m.welsh@nasa.gov">Terence Welsh</author>
    <url type="repository">https://github.com/mogumbo/rviz_lighting</url>

    <buildtool_depend>ament_cmake</buildtool_depend>
    <depend>pluginlib</depend>
    <depend>rviz_common</depend>
    <depend>rviz_rendering</depend>
    <depend>geometry_msgs</depend>
    <depend>tf2</depend>
    <depend>tf2_ros</depend>
    <depend>tf2_geometry_msgs</depend>
    <depend>visualization_msgs</depend>

    <test_depend>ament_lint_auto</test_depend>
    <test_depend>ament_lint_common</test_depend>

    <buildtool_depend>rosidl_default_generators</buildtool_depend>
    <exec_depend>rosidl_default_runtime</exec_depend>
    <member_of_group>rosidl_interface_packages</member_of_group>

    <export>
        <build_type>ament_cmake</build_type>
    </export>
</package>
